#!/usr/bin/env bash
# One-time local setup: writes .env.local (local defaults, fresh random secrets, every service
# fake) and creates the SQLite database local.db. Installs nothing. Safe to run again: an
# existing .env.local is kept unless you pass --force. See docs/guides/local-testing.md.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY="$ROOT/.venv/bin/python"
if [ ! -x "$PY" ]; then
  echo "No virtualenv at $ROOT/.venv. Create it first:" >&2
  echo "  python3 -m venv .venv && .venv/bin/pip install -e '.[dev]'" >&2
  exit 1
fi
cd "$ROOT"
exec "$PY" -m outreach.dev setup "$@"
