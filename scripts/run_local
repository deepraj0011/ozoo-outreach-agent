#!/usr/bin/env bash
# Start the agent locally: loads .env.local and runs the web app on http://127.0.0.1:8000 with the
# worker inside it (RUN_WORKER=1, a tick every 10 s). Stop with Ctrl+C. One process writes the
# SQLite database: do not also run `python -m outreach.worker --loop`. See docs/guides/local-testing.md.
# HOST=0.0.0.0 also listens on the Wi-Fi address, so tracked email links clicked on a phone in the
# same network reach the agent. The /demo console still answers only on this computer.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${ENV_FILE:-$ROOT/.env.local}"
if [ ! -f "$ENV_FILE" ]; then
  echo "No $ENV_FILE yet. Run scripts/local_setup first." >&2
  exit 1
fi
# Build the web app when it is missing or older than its sources (needs Node 20+).
WEB_INDEX="$ROOT/src/outreach/webapp/index.html"
if command -v npm >/dev/null 2>&1; then
  if [ ! -f "$WEB_INDEX" ] || [ -n "$(find "$ROOT/frontend/src" -type f -newer "$WEB_INDEX" -print -quit)" ]; then
    "$ROOT/scripts/build_web"
  fi
else
  echo "npm not found: the web app at /app will not be built (install Node 20+, then run scripts/build_web)." >&2
fi
export RUN_WORKER=1
export OUTREACH_ENV_FILE="$ENV_FILE"  # the /demo console runs dev commands with it
export WORKER_INTERVAL_S="${WORKER_INTERVAL_S:-10}"
export PYTHONUNBUFFERED=1
UVICORN=("$ROOT/.venv/bin/uvicorn" --factory outreach.app:create_app --env-file "$ENV_FILE"
  --host "${HOST:-127.0.0.1}" --port "${PORT:-8000}" --no-access-log "$@")

# EMAIL_MODE=mailpit: also run the local sender (sends due emails to Mailpit), stopped with the app.
EMAIL_MODE_VALUE="$(grep -E '^[[:space:]]*EMAIL_MODE=' "$ENV_FILE" | tail -n1 | cut -d= -f2- | tr -d '"'"'"' [:space:]')"
if [ "$EMAIL_MODE_VALUE" = "mailpit" ] || [ "$EMAIL_MODE_VALUE" = "gmail" ]; then
  "$ROOT/.venv/bin/python" -m outreach.mailpit_sender --env-file "$ENV_FILE" \
    --base-url "http://127.0.0.1:${PORT:-8000}" &
  SENDER_PID=$!
  trap 'kill "$SENDER_PID" 2>/dev/null || true' EXIT INT TERM
  echo "$EMAIL_MODE_VALUE sender started (pid $SENDER_PID)."
  "${UVICORN[@]}"
else
  exec "${UVICORN[@]}"
fi
