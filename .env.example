# SQLAlchemy database URL
DATABASE_URL=
# HMAC secret for signed redirect links
LINK_SECRET=
# Public base URL of this service
LINK_BASE_URL=
# JSON map of link purpose tag to target URL
LINK_TARGETS=
# Email tool: instantly or smartlead
TOOL_NAME=
# Email tool API key
TOOL_API_KEY=
# Email tool webhook shared secret
TOOL_WEBHOOK_SECRET=
# JSON map of timezone group to campaign id
CAMPAIGN_IDS=
# Default timezone group
DEFAULT_TZ_GROUP=
# LLM for the reply classifier and the WhatsApp chatbot. The company picks the provider here;
# no code change is needed. LLM_PROVIDER is one of: anthropic, openai, azure_openai, openai_compatible.
# LLM_API_KEY is a secret (required, except it may be empty for openai_compatible, e.g. local Ollama).
# LLM_BASE_URL is never logged. It must be https; plain http is accepted only for openai_compatible
# on a self-hosted host (localhost, 127.0.0.1, a private IP, a dot-less name such as a Docker service
# "ollama", or *.local / *.internal). LLM_TIMEOUT_S is the per-request timeout (default 30);
# the SDK retries twice on timeouts, 429 and 5xx. Model names below are placeholders.
# LLM_BASE_URL may never be a link-local address (169.254.0.0/16, fe80::/10) or a cloud metadata host.
# Output budget: openai and azure_openai send max_completion_tokens (classifier 500, chatbot 400); on
# reasoning models that budget also covers reasoning tokens, so a low reasoning effort (or a
# non-reasoning model) is recommended, or replies may be cut and handed to a person.
# openai_compatible sends max_tokens.
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
AZURE_OPENAI_API_VERSION=
# Reply classifier model (for azure_openai: the deployment name)
LLM_CLASSIFIER_MODEL=
# WhatsApp chatbot model (for azure_openai: the deployment name)
LLM_CHAT_MODEL=
# LLM_TIMEOUT_S=30
#
# --- Example: Anthropic (LLM_BASE_URL optional, defaults to https://api.anthropic.com)
# LLM_PROVIDER=anthropic
# LLM_API_KEY=<anthropic-api-key>
# LLM_CLASSIFIER_MODEL=<anthropic-model-name>
# LLM_CHAT_MODEL=<anthropic-model-name>
#
# --- Example: OpenAI (LLM_BASE_URL optional, defaults to https://api.openai.com/v1)
# LLM_PROVIDER=openai
# LLM_API_KEY=<openai-api-key>
# LLM_CLASSIFIER_MODEL=<openai-model-name>
# LLM_CHAT_MODEL=<openai-model-name>
#
# --- Example: Azure OpenAI (models are deployment names)
# LLM_PROVIDER=azure_openai
# LLM_API_KEY=<azure-openai-key>
# LLM_BASE_URL=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_API_VERSION=<api-version, e.g. 2024-10-21>
# LLM_CLASSIFIER_MODEL=<classifier-deployment-name>
# LLM_CHAT_MODEL=<chat-deployment-name>
#
# --- Example: OpenAI-compatible hosted endpoint (Gemini, Mistral, Groq, OpenRouter, ...)
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=<provider-api-key>
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_CLASSIFIER_MODEL=<provider-model-name>
# LLM_CHAT_MODEL=<provider-model-name>
#
# --- Example: self-hosted Ollama or vLLM (key may be empty)
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_CLASSIFIER_MODEL=<local-model-name>
# LLM_CHAT_MODEL=<local-model-name>
# ZeroBounce API key for intake verification
ZEROBOUNCE_API_KEY=
# API key required in X-API-Key on POST /intake
INTAKE_API_KEY=
# Cal.com webhook secret
CAL_WEBHOOK_SECRET=
# Cal.com booking URL
CAL_BOOKING_URL=
# Qualifying-form fit thresholds (defaults 50 / 3 / 10 / 6). high = size >= FIT_HIGH_MIN_SIZE and
# timeline <= FIT_HIGH_MAX_MONTHS; medium = size >= FIT_MEDIUM_MIN_SIZE or timeline <= FIT_MEDIUM_MAX_MONTHS
# FIT_HIGH_MIN_SIZE=50
# FIT_HIGH_MAX_MONTHS=3
# FIT_MEDIUM_MIN_SIZE=10
# FIT_MEDIUM_MAX_MONTHS=6
# Microsoft Teams alerts (secret). In Teams: open the sales channel, ... > Workflows, pick
# "Post to a channel when a webhook request is received", then copy the HTTP POST URL it shows.
# Must be https. Its sig= query parameter is a secret: treat the whole URL like a password.
TEAMS_WEBHOOK_URL=
# Microsoft Teams sales commands (outgoing webhook, secret). In Teams: Manage team > Apps >
# Create an outgoing webhook; callback URL = <LINK_BASE_URL>/teams/commands. Paste the security
# token Teams shows once (base64, decodes to >= 16 bytes).
TEAMS_OUTGOING_SECRET=
# Microsoft Entra tenant id of the office (Teams admin center or Azure portal > Tenant properties)
TEAMS_TENANT_ID=
# Sales channel id, e.g. 19:...@thread.tacv2 (channel ... > Get link to channel: the part after /channel/, URL-decoded)
TEAMS_SALES_CHANNEL_ID=
# Comma-separated Entra (AAD) object ids of salespeople allowed to use wa / done (Entra admin center > Users > Object ID)
TEAMS_ALLOWED_AAD_IDS=
# WhatsApp phone number id
WA_PHONE_NUMBER_ID=
# WhatsApp access token
WA_ACCESS_TOKEN=
# Meta app secret (X-Hub-Signature-256)
WA_APP_SECRET=
# WhatsApp webhook verify token
WA_VERIFY_TOKEN=
# Graph API version (default v21.0)
WA_GRAPH_VERSION=
# whatsapp or email (default whatsapp)
PRIMARY_WHEN_BOTH=
# Business timezone (default Asia/Kolkata)
BUSINESS_TZ=
# Business hours (default "Mon-Fri 09:00-18:00")
BUSINESS_HOURS=
