# SQLAlchemy database URL
DATABASE_URL=
# HMAC secret for signed redirect links
LINK_SECRET=
# Public base URL of this service
LINK_BASE_URL=
# JSON map of link purpose tag to target URL
LINK_TARGETS=
# Email tool: instantly or smartlead
TOOL_NAME=
# Email tool API key
TOOL_API_KEY=
# Email tool webhook shared secret
TOOL_WEBHOOK_SECRET=
# JSON map of timezone group to campaign id
CAMPAIGN_IDS=
# Default timezone group
DEFAULT_TZ_GROUP=
# Anthropic API key
ANTHROPIC_API_KEY=
# Reply classifier model
CLASSIFIER_MODEL=
# WhatsApp chatbot model
CHATBOT_MODEL=
# ZeroBounce API key for intake verification
ZEROBOUNCE_API_KEY=
# API key required in X-API-Key on POST /intake
INTAKE_API_KEY=
# Cal.com webhook secret
CAL_WEBHOOK_SECRET=
# Cal.com booking URL
CAL_BOOKING_URL=
# Microsoft Teams alerts (secret). In Teams: open the sales channel, ... > Workflows, pick
# "Post to a channel when a webhook request is received", then copy the HTTP POST URL it shows.
# Must be https. Its sig= query parameter is a secret: treat the whole URL like a password.
TEAMS_WEBHOOK_URL=
# Microsoft Teams sales commands (outgoing webhook, secret). In Teams: Manage team > Apps >
# Create an outgoing webhook; callback URL = <LINK_BASE_URL>/teams/commands. Paste the security
# token Teams shows once (base64, decodes to >= 16 bytes).
TEAMS_OUTGOING_SECRET=
# Microsoft Entra tenant id of the office (Teams admin center or Azure portal > Tenant properties)
TEAMS_TENANT_ID=
# Sales channel id, e.g. 19:...@thread.tacv2 (channel ... > Get link to channel: the part after /channel/, URL-decoded)
TEAMS_SALES_CHANNEL_ID=
# Comma-separated Entra (AAD) object ids of salespeople allowed to use wa / done (Entra admin center > Users > Object ID)
TEAMS_ALLOWED_AAD_IDS=
# WhatsApp phone number id
WA_PHONE_NUMBER_ID=
# WhatsApp access token
WA_ACCESS_TOKEN=
# Meta app secret (X-Hub-Signature-256)
WA_APP_SECRET=
# WhatsApp webhook verify token
WA_VERIFY_TOKEN=
# Graph API version (default v21.0)
WA_GRAPH_VERSION=
# whatsapp or email (default whatsapp)
PRIMARY_WHEN_BOTH=
# Business timezone (default Asia/Kolkata)
BUSINESS_TZ=
# Business hours (default "Mon-Fri 09:00-18:00")
BUSINESS_HOURS=
